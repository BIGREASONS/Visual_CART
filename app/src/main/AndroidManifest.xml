<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.VisualCart">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link: PayPal Sandbox Approval Return from Chrome Custom Tabs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="visualcart"
                    android:host="paypal-return" />
            </intent-filter>

            <!-- Deep Link: PayPal Sandbox Cancellation Return from Chrome Custom Tabs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="visualcart"
                    android:host="paypal-cancel" />
            </intent-filter>

            <!-- Deep Link: PayPal Sandbox Checkout Return (paypalvisualcart://checkout) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="paypalvisualcart"
                    android:host="checkout" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Dedicated Share Target Activity: Appears prominently as "Add to Visual Cart" in Sharesheet -->
        <activity
            android:name=".ui.share.VisualCartShareActivity"
            android:label="@string/share_target_label"
            android:icon="@mipmap/ic_launcher"
            android:theme="@style/Theme.VisualCart.Dialog"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <!-- ACTION_SEND for direct image shares (e.g. Long Press -> Share Image in Chrome, Polago, etc.) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- ACTION_SEND for product links (e.g. Amazon Share button, Chrome page URL) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <!-- ACTION_SEND_MULTIPLE for multi-image captures -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Circle to Shop Consent Activity -->
        <activity
            android:name=".service.capture.CircleToShopConsentActivity"
            android:theme="@style/Theme.VisualCart.Dialog"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- Quick Settings Tile Service -->
        <service
            android:name=".service.tile.VisualCartTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_quick_settings_cart"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Floating Overlay Service -->
        <service
            android:name=".service.overlay.VisualCartOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Visual Cart floating overlay for capturing and saving products across applications" />
        </service>

        <!-- Circle to Shop MediaProjection Capture Service -->
        <service
            android:name=".service.capture.CircleToShopCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
